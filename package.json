{
  "name": "blog-to-shorts",
  "version": "1.0.0",
  "description": "Blog content and images to 30–60 second vertical shorts",
  "scripts": {
    "start": "node scripts/python.mjs -m backend",
    "check": "tsc --noEmit && node scripts/python.mjs -m compileall -q backend",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "node --test tests/*.test.mjs",
    "test:backend": "node scripts/python.mjs -m pytest -q",
    "build": "vite build",
    "prestart": "npm run build"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "private": true,
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
